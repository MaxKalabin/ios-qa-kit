# Copy to config.env (kept out of git) and fill in. Read by scripts/*.sh on the Mac.
# Find the UDID with: ios list   (go-ios)  or  xcrun xctrace list devices
UDID=YOUR-IPHONE-UDID
# Bundle id of the app under test (the ONLY app the agent may touch)
APP_BUNDLE=com.example.app
# Bundle id you gave WebDriverAgent when you signed/built it
WDA_BUNDLE=com.yourname.wda.xctrunner
# Install folder on the Mac
QA_HOME=$HOME/ios-qa
PROXY_PORT=8080
# Hosts whose HTTPS mitmproxy decrypts (regex on host:port, comma-separated). Everything else is tunnelled.
# Empty = decrypt everything, which you almost never want.
QA_TARGETS=api\.example\.com,assistant\.example\.com
# Hosts with WebSocket traffic to record (plain host names, comma-separated)
QA_WS_HOSTS=assistant.example.com